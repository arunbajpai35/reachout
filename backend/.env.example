# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reverse_recruit

# Redis (queue + cache)
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL_EXTRACT=gpt-4o-2024-11-20
OPENAI_MODEL_OUTREACH=gpt-4o-2024-11-20
OPENAI_EMBED_MODEL=text-embedding-3-small

# Scraping / enrichment
APIFY_TOKEN=
CONTACTOUT_API_KEY=

# Recruiter discovery provider: "mock" (default, free, deterministic) or "contactout" (paid)
RECRUITER_PROVIDER=mock
RECRUITER_LIMIT=25

# Dev user (single-user MVP, no auth)
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@example.com

# App
APP_ENV=dev
LOG_LEVEL=INFO
