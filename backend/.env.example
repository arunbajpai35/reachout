# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reverse_recruit

# Redis (queue + cache)
REDIS_URL=redis://localhost:6379/0

# --- LLM provider ---
# Pick ONE: Azure OpenAI (set AZURE_* vars) OR direct OpenAI (set OPENAI_API_KEY).
# If Azure vars are present, Azure is used.

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_CHAT=
AZURE_OPENAI_DEPLOYMENT_EMBED=

# Direct OpenAI (unused if Azure is configured)
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=gpt-4o-2024-11-20
OPENAI_MODEL_OUTREACH=gpt-4o-2024-11-20
OPENAI_EMBED_MODEL=text-embedding-3-small

# Scraping / enrichment
APIFY_TOKEN=
CONTACTOUT_API_KEY=

# Recruiter discovery provider:
#   "mock"       - default, free, deterministic fixture data (LinkedIn URLs are fake)
#   "contactout" - paid, uses CONTACTOUT_API_KEY
#   "apify"      - paid, uses APIFY_TOKEN to run a LinkedIn-employees actor
RECRUITER_PROVIDER=mock
RECRUITER_LIMIT=25
# Optional: override which Apify actor to use for recruiter search.
# Default: apimaestro/linkedin-company-employees-scraper
APIFY_RECRUITER_ACTOR=

# Contact enrichment provider: "mock" (default, free) or "contactout" (paid, 1 credit per call)
CONTACT_PROVIDER=mock

# Dev user (single-user MVP, no auth)
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@example.com

# App
APP_ENV=dev
LOG_LEVEL=INFO
